<!-- BunnyLis 独立标头 -->
<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
  <symbol id="bunnylis-icon-search" viewBox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>
  <symbol id="bunnylis-icon-cart" viewBox="0 0 19 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M3.8 4l1.59 7.16A1 1 0 006.36 12h7.28a1 1 0 00.97-.79L16.2 4H3.8zm-.62-1h-.2a1 1 0 100 2h.56l1.64 7.36A3 3 0 007.36 15h7.28a3 3 0 002.98-2.64L19.22 5H3.18z" fill="currentColor"/>
    <circle cx="7.5" cy="16.5" r="1.5" fill="currentColor"/>
    <circle cx="13.5" cy="16.5" r="1.5" fill="currentColor"/>
  </symbol>
  <symbol id="bunnylis-icon-hamburger" viewBox="0 0 18 16" fill="none">
    <path d="M1 .5a.5.5 0 100 1h15a.5.5 0 000-1H1zM.5 8a.5.5 0 01.5-.5h15a.5.5 0 010 1H1A.5.5 0 01.5 8zm0 7a.5.5 0 01.5-.5h15a.5.5 0 010 1H1a.5.5 0 01-.5-.5z" fill="currentColor"/>
  </symbol>
</svg>

<style>
  .bunnylis-header {
    background-color: {{ section.settings.header_bg_color | default: '#ffb6c1' }};
    color: {{ section.settings.header_text_color | default: '#ffffff' }};
    padding: 1rem 0;
    position: relative;
    z-index: 100;
    border-bottom: 1px solid rgba(255,255,255,0.2);
  }
  
  .bunnylis-header__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .bunnylis-header__logo {
    font-size: 1.8rem;
    font-weight: bold;
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
  }
  
  .bunnylis-header__logo img {
    max-height: 50px;
    width: auto;
  }
  
  .bunnylis-header__nav {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2rem;
  }
  
  .bunnylis-header__nav-link {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 0;
    transition: opacity 0.2s ease;
  }
  
  .bunnylis-header__nav-link:hover {
    opacity: 0.8;
  }
  
  .bunnylis-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .bunnylis-header__icon {
    color: inherit;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    transition: opacity 0.2s ease;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
  }
  
  .bunnylis-header__icon:hover {
    opacity: 0.8;
  }
  
  .bunnylis-header__icon svg {
    width: 20px;
    height: 20px;
  }
  
  .bunnylis-header__cart-count {
    position: absolute;
    top: 5px;
    right: 5px;
    background-color: #ff4444;
    color: white;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: bold;
    line-height: 1;
  }
  
  .bunnylis-header__mobile-toggle {
    display: none;
  }
  
  @media (max-width: 768px) {
    .bunnylis-header__nav {
      display: none;
    }
    
    .bunnylis-header__mobile-toggle {
      display: flex;
    }
    
    .bunnylis-header__container {
      padding: 0 1rem;
    }
    
    .bunnylis-header__logo {
      font-size: 1.5rem;
    }
  }
  
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
  
  .hidden {
    display: none !important;
  }
</style>

<header class="bunnylis-header">
  <div class="bunnylis-header__container">
    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="bunnylis-header__logo">
      {%- if section.settings.logo_image != blank -%}
        <img src="{{ section.settings.logo_image | image_url: width: 200 }}" 
             alt="{{ shop.name }}" 
             width="200" 
             height="50"
             loading="lazy">
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name }}
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    {%- if section.settings.menu != blank -%}
      <nav class="bunnylis-header__nav-wrapper">
        <ul class="bunnylis-header__nav">
          {%- for link in linklists[section.settings.menu].links -%}
            <li>
              <a href="{{ link.url }}" class="bunnylis-header__nav-link">
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <!-- Header Actions -->
    <div class="bunnylis-header__actions">
      <!-- Mobile Menu Toggle -->
      <button type="button" 
              class="bunnylis-header__icon bunnylis-header__mobile-toggle"
              aria-label="打开菜单">
        <svg aria-hidden="true" focusable="false">
          <use href="#bunnylis-icon-hamburger"></use>
        </svg>
      </button>

      <!-- Search -->
      <a href="{{ routes.search_url }}" 
         class="bunnylis-header__icon"
         aria-label="搜索">
        <svg aria-hidden="true" focusable="false">
          <use href="#bunnylis-icon-search"></use>
        </svg>
      </a>

      <!-- Cart -->
      <a href="{{ routes.cart_url }}" 
         class="bunnylis-header__icon"
         aria-label="购物车">
        <svg aria-hidden="true" focusable="false">
          <use href="#bunnylis-icon-cart"></use>
        </svg>
        {%- if cart != empty -%}
          <span class="bunnylis-header__cart-count">
            {{ cart.item_count }}
            <span class="visually-hidden">个商品</span>
          </span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "BunnyLis Header",
  "class": "bunnylis-header-section",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "BunnyLis"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Header Background Color",
      "default": "#ffb6c1"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header Text Color",
      "default": "#ffffff"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
