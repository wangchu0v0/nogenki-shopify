{
  "sections": {
    "bunnylis_header": {
      "type": "bunnylis-header",
      "settings": {
        "logo_text": "BunnyLis",
        "header_bg_color": "#ffb6c1",
        "header_text_color": "#ffffff",
        "menu": "main-menu"
      }
    },
    "main": {
      "type": "main-page",
      "settings": {
        "padding_top": 28,
        "padding_bottom": 28
      }
    },
    "bunnylis_banner": {
      "type": "image-banner",
      "settings": {
        "image": "shopify://shop_images/bunnylis-banner.jpg",
        "image_overlay_opacity": 30,
        "image_height": "medium",
        "desktop_content_position": "middle-center",
        "show_text_box": true,
        "desktop_content_alignment": "center",
        "color_scheme": "scheme-1",
        "image_behavior": "none",
        "mobile_content_alignment": "center",
        "stack_images_on_mobile": true,
        "show_text_below": true
      }
    },
    "bunnylis_rich_text": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Welcome to BunnyLis",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Discover our cute and lovely fashion collection designed especially for you. BunnyLis brings you the sweetest styles with a touch of elegance.</p>"
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-1",
        "full_width": true,
        "padding_top": 40,
        "padding_bottom": 40
      }
    },
    "bunnylis_collection": {
      "type": "featured-collection",
      "settings": {
        "title": "BunnyLis Collection",
        "heading_size": "h2",
        "description": "",
        "show_description": false,
        "description_style": "body",
        "collection": "bunnylis",
        "products_to_show": 8,
        "columns_desktop": 4,
        "full_width": false,
        "show_view_all": true,
        "view_all_style": "solid",
        "enable_desktop_slider": false,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
        "columns_mobile": "2",
        "swipe_on_mobile": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "bunnylis_header",
    "main",
    "bunnylis_banner",
    "bunnylis_rich_text",
    "bunnylis_collection"
  ]
}
