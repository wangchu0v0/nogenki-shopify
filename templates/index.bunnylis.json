{
  "layout": "bunnylis",
  "sections": {
    "bunnylis_header": {
      "type": "bunnylis-header",
      "settings": {
        "logo_text": "BunnyLis",
        "header_bg_color": "#ffb6c1",
        "header_text_color": "#ffffff",
        "menu": "main-menu"
      }
    },
    "slideshow_bunnylis": {
      "type": "slideshow",
      "blocks": {
        "slide_bunnylis_1": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/bunnylis-hero-1.jpg",
            "heading": "BunnyLis Collection",
            "heading_size": "h1",
            "subheading": "Cute & Lovely Fashion",
            "button_label": "Shop Now",
            "link": "shopify://collections/bunnylis",
            "button_style_secondary": false,
            "box_align": "middle-center",
            "show_text_box": true,
            "text_alignment": "center",
            "image_overlay_opacity": 20,
            "color_scheme": "scheme-1",
            "text_alignment_mobile": "center"
          }
        }
      },
      "settings": {
        "layout": "full_bleed",
        "slide_height": "adapt_image",
        "slider_visual": "dots",
        "auto_rotate": false,
        "change_slides_speed": 5,
        "accessibility_info": "Slideshow about our products"
      }
    },
    "featured_collection_bunnylis": {
      "type": "bunnylis-featured-collection",
      "settings": {
        "title": "Featured BunnyLis Items",
        "heading_size": "h2",
        "description": "",
        "show_description": false,
        "description_style": "body",
        "collection": "bunnylis",
        "products_to_show": 8,
        "columns_desktop": 4,
        "full_width": false,
        "show_view_all": true,
        "view_all_style": "solid",
        "enable_desktop_slider": false,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "enable_quick_add": false,
        "columns_mobile": "2",
        "swipe_on_mobile": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "rich_text_bunnylis": {
      "type": "bunnylis-rich-text",
      "blocks": {
        "heading_bunnylis": {
          "type": "heading",
          "settings": {
            "heading": "Welcome to BunnyLis World",
            "heading_size": "h1"
